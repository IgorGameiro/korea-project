// korea-project Prisma schema.
//
// Conventions
// - IDs: UUID v7 (time-ordered, generated by Prisma Client) stored as native `uuid`.
// - Money in KRW is Int (the won has no minor unit). Exchange rates are Decimal.
// - Public URLs use `slug`; write endpoints use `id`.
// - Content (City/District/Place/Accommodation/CostEstimate) uses onDelete: Restrict, so an admin
//   must remove children first. User-owned rows that make no sense alone (RefreshToken, Favorite) cascade.
// - CHECK constraints (ranges, non-negative money) live in the migration SQL: Prisma cannot declare them.
// - Enum values must stay identical to packages/shared/src/enums.ts (enforced by a unit test).
// - i18n: translatable text lives in <Entity>Translation tables, one row per (entity, locale).
//   Locales are BCP 47 strings ("en", "pt-BR"; see packages/shared/src/i18n.ts), restricted by a
//   CHECK constraint. Every entity has an "en" row; the API falls back to it for missing locales.
//   Slugs, tags and addresses are language-neutral (English keys / romanized Korean).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum PlaceCategory {
  RESTAURANT
  NIGHTLIFE
  HIKING
  ATTRACTION
  CAFE
  SHOPPING
  CULTURE
  NATURE
}

/// Travel style. Used by Accommodation.tier and CostEstimate.tier.
enum CostTier {
  BUDGET
  MID
  LUXURY
}

enum AccommodationType {
  HOTEL
  HOSTEL
  GUESTHOUSE
  HANOK
  APARTMENT
}

enum TrailDifficulty {
  EASY
  MODERATE
  HARD
}

enum Role {
  USER
  ADMIN
}

// ---------------------------------------------------------------------------
// Destinations
// ---------------------------------------------------------------------------

model City {
  id           String   @id @default(uuid(7)) @db.Uuid
  slug         String   @unique
  nameKo       String
  heroImageUrl String
  latitude     Float
  longitude    Float
  population   Int?
  /// Shown in the Home "featured cities" grid, ordered by sortOrder.
  isFeatured   Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  translations   CityTranslation[]
  districts      District[]
  places         Place[]
  accommodations Accommodation[]
  costEstimates  CostEstimate[]

  @@index([isFeatured, sortOrder])
}

model CityTranslation {
  id              String   @id @default(uuid(7)) @db.Uuid
  cityId          String   @db.Uuid
  /// BCP 47 tag ("en", "pt-BR"). CHECK constraint in the migration.
  locale          String   @db.VarChar(10)
  name            String
  description     String
  bestTimeToVisit String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([cityId, locale])
}

model District {
  id        String   @id @default(uuid(7)) @db.Uuid
  cityId    String   @db.Uuid
  slug      String
  nameKo    String
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city           City                  @relation(fields: [cityId], references: [id], onDelete: Restrict)
  translations   DistrictTranslation[]
  places         Place[]
  accommodations Accommodation[]

  @@unique([cityId, slug])
}

model DistrictTranslation {
  id          String   @id @default(uuid(7)) @db.Uuid
  districtId  String   @db.Uuid
  locale      String   @db.VarChar(10)
  name        String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  district District @relation(fields: [districtId], references: [id], onDelete: Cascade)

  @@unique([districtId, locale])
}

model Place {
  id              String        @id @default(uuid(7)) @db.Uuid
  cityId          String        @db.Uuid
  districtId      String?       @db.Uuid
  category        PlaceCategory
  /// Globally unique: the public URL is /places/[slug], without the city.
  slug            String        @unique
  nameKo          String
  /// Romanized street address (not translated).
  address         String
  latitude        Float
  longitude       Float
  /// 1 (cheap) to 4 (expensive). CHECK constraint in the migration.
  priceLevel      Int           @db.SmallInt
  averageSpendKRW Int
  /// OpeningHours from @korea-project/shared. Null = not informed.
  openingHours    Json?
  website         String?
  imageUrls       String[]
  tags            String[]
  /// Denormalized from Review; kept in sync in the same transaction as review writes.
  ratingAvg       Float         @default(0)
  ratingCount     Int           @default(0)

  // Hiking-only fields (category = HIKING).
  difficulty      TrailDifficulty?
  distanceKm      Float?
  durationMinutes Int?
  elevationGainM  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city         City               @relation(fields: [cityId], references: [id], onDelete: Restrict)
  district     District?          @relation(fields: [districtId], references: [id], onDelete: Restrict)
  translations PlaceTranslation[]
  reviews      Review[]
  favorites    Favorite[]

  @@index([cityId, category, ratingAvg(sort: Desc)])
  @@index([cityId, priceLevel])
  @@index([districtId])
  @@index([tags], type: Gin)
}

model PlaceTranslation {
  id               String   @id @default(uuid(7)) @db.Uuid
  placeId          String   @db.Uuid
  locale           String   @db.VarChar(10)
  name             String
  description      String
  /// Caveats about the schedule in Place.openingHours (holidays, reservations, seasons).
  openingHoursNote String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, locale])
}

model Accommodation {
  id               String            @id @default(uuid(7)) @db.Uuid
  cityId           String            @db.Uuid
  districtId       String?           @db.Uuid
  slug             String            @unique
  name             String
  type             AccommodationType
  tier             CostTier
  pricePerNightKRW Int
  latitude         Float
  longitude        Float
  bookingUrl       String?
  imageUrls        String[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  city     City      @relation(fields: [cityId], references: [id], onDelete: Restrict)
  district District? @relation(fields: [districtId], references: [id], onDelete: Restrict)

  @@index([cityId, tier])
  @@index([districtId])
}

/// Daily cost assumptions per city and travel style, used by the cost calculator.
model CostEstimate {
  id                           String   @id @default(uuid(7)) @db.Uuid
  cityId                       String   @db.Uuid
  tier                         CostTier
  lodgingPerRoomPerNightKRW    Int
  foodPerPersonPerDayKRW       Int
  transportPerPersonPerDayKRW  Int
  activitiesPerPersonPerDayKRW Int
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  city City @relation(fields: [cityId], references: [id], onDelete: Restrict)

  @@unique([cityId, tier])
}

/// Conversion rates from KRW to each display currency (KRW->BRL, KRW->USD). The API reads this
/// table; in the MVP the seed fills it from KRW_TO_BRL / KRW_TO_USD.
model ExchangeRate {
  id        String   @id @default(uuid(7)) @db.Uuid
  base      String   @db.Char(3)
  target    String   @db.Char(3)
  /// How many `target` units one `base` unit buys.
  rate      Decimal  @db.Decimal(18, 8)
  /// Where the rate came from ("env", or an external provider later).
  source    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([base, target])
}

// ---------------------------------------------------------------------------
// Users & engagement
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String
  /// Always stored lowercased (normalized in the service layer).
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  reviews       Review[]
  favorites     Favorite[]
}

/// Refresh tokens are rotated on every use. Only a hash is stored. All tokens issued from one
/// login share a familyId: presenting an already-rotated token revokes the whole family.
model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  familyId     String    @db.Uuid
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model Review {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  placeId   String    @db.Uuid
  /// 1 to 5. CHECK constraint in the migration.
  rating    Int       @db.SmallInt
  /// Language the review was written in (BCP 47). Reviews are never machine-translated.
  locale    String    @db.VarChar(10)
  title     String
  comment   String
  visitedAt DateTime? @db.Date
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  place Place @relation(fields: [placeId], references: [id], onDelete: Restrict)

  /// A user can review a place only once.
  @@unique([userId, placeId])
  @@index([placeId, createdAt(sort: Desc)])
}

model Favorite {
  userId    String   @db.Uuid
  placeId   String   @db.Uuid
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([userId, placeId])
  @@index([placeId])
}
