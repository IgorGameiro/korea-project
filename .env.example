# =============================================================================
# korea-project — environment variables
# Copy to .env at the repo root:  cp .env.example .env
# The API validates these at startup and refuses to boot if something is missing.
# =============================================================================

NODE_ENV=development

# ---------------------------------------------------------------------------
# PostgreSQL (docker compose)
# ---------------------------------------------------------------------------
POSTGRES_USER=korea
POSTGRES_PASSWORD=korea
POSTGRES_DB=korea_project
# Host port. 5433 avoids clashing with a Postgres already running on 5432.
POSTGRES_PORT=5433

# Used by the API and the Prisma CLI when running on the host (pnpm dev).
# Inside docker compose this is overridden to point at the `postgres` service.
DATABASE_URL=postgresql://korea:korea@localhost:5433/korea_project?schema=public
# Database used by `pnpm test:e2e`. The suite drops and recreates it, and refuses to run unless the
# database name contains "_test".
TEST_DATABASE_URL=postgresql://korea:korea@localhost:5433/korea_project_test?schema=public

# ---------------------------------------------------------------------------
# API (NestJS)
# ---------------------------------------------------------------------------
API_PORT=3001
# Comma-separated list of origins allowed by CORS (the web app).
CORS_ORIGINS=http://localhost:3000
# Swagger UI at /api/docs. Disable in production if the API must not be self-documenting.
SWAGGER_ENABLED=true

# JWT (used from Phase 3). Secrets must have at least 32 characters.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_REFRESH_EXPIRES_IN=7d
# Set to true behind HTTPS so the refresh-token cookie is only sent over TLS.
COOKIE_SECURE=false
# Reverse proxies in front of the API whose X-Forwarded-For is trusted. The web app forwards every
# browser call to the API (same-origin /api/v1 gateway), so this is 1. Use 0 only if browsers call
# the API directly. See README, "Before production".
TRUST_PROXY=1
# Shared secret of the web server's own server-side calls (build, ISR); they are not rate limited.
# Server-only: never expose it to the browser. At least 32 characters.
INTERNAL_API_TOKEN=change-me-internal-token-at-least-32-characters

# Rate limiting: global, and stricter for /api/v1/auth/*
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_TTL_MS=60000
THROTTLE_AUTH_LIMIT=10
# Requests per minute to GET /api/v1/search (the most expensive public query).
THROTTLE_SEARCH_LIMIT=30

# Default cache TTL (in-memory store in the MVP).
CACHE_TTL_MS=60000

# ---------------------------------------------------------------------------
# Seed (development data only — never used in production)
# ---------------------------------------------------------------------------
# Passwords for the demo accounts created by `pnpm --filter @korea-project/api db:seed`:
#   admin@example.com (ADMIN) uses SEED_ADMIN_PASSWORD
#   ana.souza@, bruno.lima@, carla.mendes@, diego.rocha@example.com use SEED_USER_PASSWORD
# Production mode skips the demo seed; set to true to load it anyway (a demo deployment).
SEED_DEMO_DATA=false
SEED_ADMIN_PASSWORD=admin-dev-password
SEED_USER_PASSWORD=user-dev-password
# Exchange rates written to the ExchangeRate table by the seed (the API reads the table, not these).
# How many BRL / USD one KRW buys. ESTIMATES — review before relying on them.
KRW_TO_BRL=0.0039
KRW_TO_USD=0.00072

# ---------------------------------------------------------------------------
# Web (Next.js)
# ---------------------------------------------------------------------------
WEB_PORT=3000
# Public URL of the site (SEO, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# API base URL as seen by the browser.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# API base URL used by server components (SSR/ISR). In docker compose: http://api:3001/api/v1
API_INTERNAL_URL=http://localhost:3001/api/v1
# Map tiles (optional; inlined at build time). Empty = public OpenStreetMap tiles, which are for
# development only: review the OSM tile usage policy and set a provider before production (README).
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=
